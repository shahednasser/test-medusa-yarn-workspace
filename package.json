{
  "name": "test-storefront-hosting",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/backend",
    "apps/storefront"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:storefront": "turbo run dev --filter=storefront",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=backend",
    "build:storefront": "turbo run build --filter=storefront",
    "start": "turbo run start",
    "start:backend": "turbo run start --filter=backend",
    "start:storefront": "turbo run start --filter=storefront"
  },
  "packageManager": "yarn@3.6.4",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "turbo": "^2.7.3"
  }
}
